{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime ApplicationSpec v1",
  "definitions": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "type": {
          "enum": [
            "text",
            "integer",
            "boolean",
            "date",
            "choice",
            "reference",
            "file"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "options": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "default": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "type"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "roles": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,47}$"
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "label": {
            "type": "string",
            "maxLength": 160
          },
          "fields": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/definitions/field"
            }
          },
          "read_roles": {
            "type": "array",
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            }
          },
          "write_roles": {
            "type": "array",
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            }
          }
        },
        "required": [
          "id",
          "label",
          "fields",
          "read_roles",
          "write_roles"
        ]
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "blocks": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "table",
                    "form",
                    "cards",
                    "files",
                    "action"
                  ]
                },
                "title": {
                  "type": "string",
                  "maxLength": 160
                },
                "entity": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "action": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "fields": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  }
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "blocks"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9._-]+@[0-9]+$"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "inputs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/definitions/field"
            }
          },
          "outputs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/definitions/field"
            }
          }
        },
        "required": [
          "id",
          "description",
          "inputs",
          "outputs"
        ]
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "label": {
            "type": "string",
            "maxLength": 160
          },
          "entity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "capability": {
            "type": "string"
          },
          "inputs": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            }
          }
        },
        "required": [
          "id",
          "label",
          "entity",
          "capability",
          "inputs",
          "outputs",
          "roles"
        ]
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_roles",
        "write_roles"
      ],
      "properties": {
        "read_roles": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          }
        },
        "write_roles": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          }
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "max_space_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "roles",
    "entities",
    "pages",
    "capabilities",
    "actions"
  ]
}
