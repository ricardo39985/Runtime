# scripts/bootstrap.sh generates unique development credentials in ignored .env.
APP_ENV=development
RUNTIME_PORT=8080
DEV_API_TOKEN=
DEV_READER_TOKEN=
BRIDGE_TOKEN=
DB_PASSWORD=
APP_DB_PASSWORD=
# Optional live composition. Disabled unless explicitly configured.
PLANNER_ENABLED=false
PLANNER_MODEL=
OPENAI_API_KEY=
# Enter verified account-specific prices as integer microdollars per million tokens.
# Zero leaves the planner disabled. A dollar is 1,000,000 microdollars.
PLANNER_INPUT_MICROUSD_PER_MILLION=0
PLANNER_OUTPUT_MICROUSD_PER_MILLION=0
GENERATION_CEILING_MICROUSD=250000
MODEL_MONTHLY_MICROUSD=100000000
